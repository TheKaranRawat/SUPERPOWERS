<?xml version="1.0" encoding="utf-8"?>
<Context Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow" >

  <Box Style="BGBlock_ClearTopBar" ID="BGBlock" />

  <!-- Height of Popup is recalculated in Lua from MainStack -->
  <Grid ID="Popup" Size="500,560" Anchor="C,C" Offset="0,60" Padding="0,0" Style="Grid9DetailFive140" ConsumeMouse="1">

    <Image ID="TitleIcon" Anchor="C,T" AnchorSide="I.O" Offset="0,-36" Texture="Assets/UI/Art/Controls/CityStatePopupTop100.dds" Size="300.200" Hidden="0"/>

    <Box Style="MenuLeftSideTreatment"/>
    <Box Style="MenuRightSideTreatment"/>

    <Stack ID="MainStack" Anchor="C,T" Offset="0,46" Padding="8" StackGrowth="Bottom">

      <!-- Title -->
      <Label Anchor="C,T" Font="TwCenMT24" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="City State Name and Type" ID="TitleLabel" >
        <Image Anchor="L,C" AnchorSide="O.I" Size="32,32" Texture="Assets/UI/Art/Icons/CivSymbolAtlas32.dds" Color="201,248,255,255" ID="CivIcon" Hidden="0"/>
      </Label>

      <!-- Body Text -->
      <Label Anchor="C,T" WrapWidth="440" LeadingOffset="-4" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" ID="DescriptionLabel" String="" />

      <Image Anchor="C,T" Texture="bar300x2.dds" Size="300.1">
        <Image ID="BackgroundImage" Anchor="C,T" Color="White.80" Size="460.200" Hidden="0"/>
      </Image>

      <!-- TOP ROW (drawn on top of the background image):
           Personality | Status / Influence bar (with trait icon) | Current Ally -->
      <Stack Anchor="C,T" Offset="0,-27" StackGrowth="Right" Padding="0">

        <!-- Personality -->
        <Box Anchor="L,C" Size="130,60" Offset="0,5" Color="White.0" >
          <Stack Anchor="C,C" StackGrowth="Bottom" Padding="2">
            <Label ID="PersonalityLabel" Anchor="C,T" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_POP_CSTATE_PERSONALITY" />
            <Label ID="PersonalityInfo" Anchor="C,T" WrapWidth="124" String="" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" />
          </Stack>
        </Box>

        <!-- Status / Influence bar. StatusIcon is the trait icon: hover it to see the trait name. -->
        <Box Anchor="L,C" Size="200,60" Color="White.0" >
          <Image ID="StatusIconBG" Anchor="R,T" Offset="-10,14" Size="32.32" Texture="Blank.dds" Hidden="0" >
            <Image ID="StatusIcon" Anchor="C,C" Offset="0.0" Texture="Assets/UI/Art/Notification/CityStateMilitaristic.dds" Size="32.32" Hidden="1" />
            <Image Anchor="L,B" Offset="0,-5" AnchorSide="O.I" Texture="Assets/UI/Art/Notification/CityStateMeterFrame.dds" Size="158.9" Hidden="0" >
              <Label ID="StatusLabel" AnchorSide="I.O" Anchor="L,T" Offset="22,5" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_POP_CSTATE_STATUS">
                <Label ID="StatusInfo" Anchor="R,T" AnchorSide="O.I" Offset="12,0" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" />
              </Label>
              <TextureBar ID="StatusMeter" Anchor="C,C" Size="156.7" Direction="Right" Texture="Assets/UI/Art/Notification/CityStateMeterBaseRed.dds" Hidden="0" />
            </Image>
          </Image>
        </Box>

        <!-- Current Ally -->
        <Box Anchor="L,C" Size="130,60" Offset="0,5" Color="White.0" >
          <Stack Anchor="C,C" StackGrowth="Bottom" Padding="2">
            <Label ID="AllyLabel" Anchor="C,T" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_POP_CSTATE_ALLIED_WITH" />
            <Label ID="AllyInfo" Anchor="C,T" WrapWidth="124" String="" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" />
          </Stack>
        </Box>

      </Stack>

      <!-- Spacer: pushes the stats below the background image -->
      <Box Anchor="C,T" Size="1,140" Color="0,0,0,0" />

      <!-- City State stats -->
      <Stack ID="StatsStack" Anchor="C,T" StackGrowth="Right" Padding="6">
        <Button ID="PopButton" Size="110,44">
          <Box Anchor="C,C" Size="110,44" Color="0,0,0,120" />
          <Box Anchor="C,T" Size="110,2" Color="120,200,110,255" />
          <Label ID="PopValue" Anchor="C,T" Offset="0,5" Font="TwCenMT20" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="-" />
          <Label ID="PopCaption" Anchor="C,B" Offset="0,3" Font="TwCenMT14" FontStyle="Shadow" Color="200,200,200,255" String="" />
        </Button>
        <Button ID="ProdButton" Size="110,44">
          <Box Anchor="C,C" Size="110,44" Color="0,0,0,120" />
          <Box Anchor="C,T" Size="110,2" Color="225,150,60,255" />
          <Label ID="ProdValue" Anchor="C,T" Offset="0,5" Font="TwCenMT20" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="-" />
          <Label ID="ProdCaption" Anchor="C,B" Offset="0,3" Font="TwCenMT14" FontStyle="Shadow" Color="200,200,200,255" String="" />
        </Button>
        <Button ID="SciButton" Size="110,44">
          <Box Anchor="C,C" Size="110,44" Color="0,0,0,120" />
          <Box Anchor="C,T" Size="110,2" Color="90,170,235,255" />
          <Label ID="SciValue" Anchor="C,T" Offset="0,5" Font="TwCenMT20" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="-" />
          <Label ID="SciCaption" Anchor="C,B" Offset="0,3" Font="TwCenMT14" FontStyle="Shadow" Color="200,200,200,255" String="" />
        </Button>
        <Button ID="GoldButton" Size="110,44">
          <Box Anchor="C,C" Size="110,44" Color="0,0,0,120" />
          <Box Anchor="C,T" Size="110,2" Color="235,200,70,255" />
          <Label ID="GoldValue" Anchor="C,T" Offset="0,5" Font="TwCenMT20" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="-" />
          <Label ID="GoldCaption" Anchor="C,B" Offset="0,3" Font="TwCenMT14" FontStyle="Shadow" Color="200,200,200,255" String="" />
        </Button>
      </Stack>

      <!-- Resources (hidden by Lua when there is nothing to show) -->
      <Stack ID="ResourcesGroup" Anchor="C,T" StackGrowth="Bottom" Padding="2">
        <Label ID="ResourcesLabel" Anchor="C,T" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_POP_CSTATE_RESOURCES"/>
        <Label ID="ResourcesInfo" String="" WrapWidth="440" Anchor="C,T" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" />
      </Stack>

      <Image Anchor="C,T" Texture="bar300x2.dds" Size="300.1" />

      <!-- GIFTS: always visible, side by side -->
      <Stack ID="GiftStack" Anchor="C,T" StackGrowth="Right" Padding="4">
        <Button ID="SmallGiftButton" Size="112,58" ToolTip="TXT_KEY_POP_CSTATE_GOLD_TT">
          <Box Anchor="C,C" Size="112,58" Color="0,0,0,110" />
          <Label ID="SmallGift" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="100" LeadingOffset="-6" String="MINOR_GOLD_GIFT_SMALL" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="112,58" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="112,58" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
        <Button ID="MediumGiftButton" Size="112,58" ToolTip="TXT_KEY_POP_CSTATE_GOLD_TT">
          <Box Anchor="C,C" Size="112,58" Color="0,0,0,110" />
          <Label ID="MediumGift" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="100" LeadingOffset="-6" String="MINOR_GOLD_GIFT_MEDIUM" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="112,58" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="112,58" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
        <Button ID="LargeGiftButton" Size="112,58" ToolTip="TXT_KEY_POP_CSTATE_GOLD_TT">
          <Box Anchor="C,C" Size="112,58" Color="0,0,0,110" />
          <Label ID="LargeGift" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="100" LeadingOffset="-6" String="MINOR_GOLD_GIFT_LARGE" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="112,58" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="112,58" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
        <Button ID="UnitGiftButton" Size="112,58" ToolTip="TXT_KEY_POP_CSTATE_GIFT_UNIT_TT">
          <Box Anchor="C,C" Size="112,58" Color="0,0,0,110" />
          <Label ID="UnitGift" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="100" LeadingOffset="-6" String="TXT_KEY_POP_CSTATE_GIFT_UNIT" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="112,58" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="112,58" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
      </Stack>

      <!-- ACTIONS -->
      <Stack ID="ActionStack" Anchor="C,T" StackGrowth="Right" Padding="4">
        <Button ID="PeaceButton" Size="148,40" Hidden="1">
          <Box Anchor="C,C" Size="148,40" Color="0,0,0,110" />
          <Label ID="PeaceLabel" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="136" LeadingOffset="-6" String="TXT_KEY_POP_CSTATE_MAKE_PEACE" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="148,40" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="148,40" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
        <Button ID="WarButton" Size="148,40">
          <Box Anchor="C,C" Size="148,40" Color="0,0,0,110" />
          <Label ID="WarLabel" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="136" LeadingOffset="-6" String="TXT_KEY_POP_CSTATE_DECLARE_WAR" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="148,40" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="148,40" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
        <Button ID="PledgeButton" Size="148,40" ToolTip="TXT_KEY_POP_CSTATE_PLEDGE_TT">
          <Box Anchor="C,C" Size="148,40" Color="0,0,0,110" />
          <Label ID="PledgeLabel" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="136" LeadingOffset="-6" String="TXT_KEY_POP_CSTATE_PLEDGE_TO_PROTECT" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="148,40" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="148,40" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
        <Button ID="NoUnitSpawningButton" Size="148,40" ToolTip="TXT_KEY_POP_CSTATE_STOP_UNITS_TT">
          <Box Anchor="C,C" Size="148,40" Color="0,0,0,110" />
          <Label ID="NoUnitSpawningLabel" Anchor="C,C" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" WrapWidth="136" LeadingOffset="-6" String="TXT_KEY_POP_CSTATE_STOP_UNIT_SPAWNING" />
          <ShowOnMouseOver>
            <AlphaAnim Anchor="C,C" Size="148,40" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="2" AlphaEnd="1">
              <Grid Size="148,40" Padding="0,0" Style="Grid9FrameTurnsHL" />
            </AlphaAnim>
          </ShowOnMouseOver>
        </Button>
      </Stack>

      <!-- CLOSE -->
      <GridButton Anchor="C,T" Style="SmallButton" Size="150,32" StateOffsetIncrement="0,0" ID="CloseButton" >
        <Label Anchor="C,C" String="TXT_KEY_CLOSE" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Shadow" />
      </GridButton>

    </Stack>

  </Grid>

  <!-- War Confirmation Popup -->

  <Box Style="BGBlock" ID="WarConfirm" Hidden="1" ConsumeMouseOver="1">
    <Grid Size="500,410" Anchor="C,C" Offset="0,0" Padding="0,20" Style="Grid9DetailFive140" Hidden="0" >

      <Box Style="MenuLeftSideTreatment"/>
      <Box Style="MenuRightSideTreatment"/>

      <Image Anchor="C,T" AnchorSide="I.O" Offset="0,-27" Size="256,64" Texture="DecTop256x64.dds" >
        <Image Anchor="C,C" Offset="0,-6" Size="80,80" Texture="NotificationFrameBase.dds" >
          <AlphaAnim Anchor="C,C" Offset="0,0" Size="80.80" Texture="assets\UI\Art\Notification\NotificationGenericGlow.dds" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="1" AlphaEnd=".5"/>
        </Image>
      </Image>

      <Label Anchor="C,T" Offset="0,74" WrapWidth="440" String="" ID="WarConfirmLabel" Font="TwCenMT22" ColorSet="Beige_Black_Alpha" FontStyle="Shadow" />
      <Stack Anchor="C,B" Offset="0,80" Padding="24" StackGrowth="Bottom">
        <GridButton Style="BaseButton" ID="Yes" Size="400,42" Anchor="C,T" Offset="0,0" Hidden="0">
          <Label Anchor="C,C" Offset="0,0" String="TXT_KEY_YES_BUTTON" ColorSet="Beige_Black" Font="TwCenMT24" FontStyle="Shadow" />
        </GridButton>
        <GridButton Style="BaseButton" ID="No" Size="400,42" Anchor="C,T" Offset="0,0" Hidden="0">
          <Label Anchor="C,C" Offset="0,0" String="TXT_KEY_NO_BUTTON" ColorSet="Beige_Black" Font="TwCenMT24" FontStyle="Shadow" />
        </GridButton>
      </Stack>
    </Grid>
  </Box>

</Context>