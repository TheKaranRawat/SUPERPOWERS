        </Container>
        <Container Anchor="R,C" Size="160,26">
          <Label Anchor="L,C" String="TXT_KEY_CULTURE_STATS" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
          <Label ID="Culture" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        </Container>
      </Container>
      <Container Size="330,26">
        <Container Anchor="L,C" Size="160,26">
          <Label Anchor="L,C" String="TXT_KEY_CITIES_STATS" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
          <Label ID="Cities" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        </Container>
        <Container Anchor="R,C" Size="160,26">
          <Label Anchor="L,C" String="TXT_KEY_HAPPINESS_STATS" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
          <Label ID="Happy" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        </Container>
      </Container>

    </Stack>
