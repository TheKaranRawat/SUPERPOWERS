          <Label ID="Prod" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        </Container>
        <Container Anchor="R,C" Size="160,26">
          <Label Anchor="L,C" String="TXT_KEY_POPULATION_STATS" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
          <Label ID="Pop" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        </Container>
      </Container>

      <Box Size="330,1" Color="201,162,74,60"/>

      <!-- ============ CULTURE ============ -->
      <Label String="SOCIETY" Anchor="L,C" Font="TwCenMT22" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
      <Container Size="330,26">
        <Container Anchor="L,C" Size="160,26">
          <Label Anchor="L,C" String="TXT_KEY_WONDERS_STATS" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
