<?xml version="1.0" encoding="utf-8"?>
<Context ColorSet="Beige_Black_Alpha" Font="TwCenMT20" FontStyle="Shadow">

  <!-- ============ INSTANCES ============ -->

  <!-- One chip per war group -->
  <Instance Name="WarChip">
    <Container ID="ChipRoot" Size="224,96">
      <AlphaAnim ID="ChipAlpha" Size="224,96" Start="0" End="1" Speed="3" Cycle="Once" Function="Root">
        <Button ID="ChipButton" Size="224,96" ConsumeMouse="1">

          <!-- rounded glow behind each icon, only visible on hover -->
          <ShowOnMouseOver>
            <Image ID="G1" Texture="WarTrackerGlow.dds" Anchor="L,T" Offset="0,0"   Size="96,96"/>
            <Image ID="G2" Texture="WarTrackerGlow.dds" Anchor="L,T" Offset="32,0"  Size="96,96"/>
            <Image ID="G3" Texture="WarTrackerGlow.dds" Anchor="L,T" Offset="64,0"  Size="96,96"/>
            <Image ID="G4" Texture="WarTrackerGlow.dds" Anchor="L,T" Offset="96,0"  Size="96,96"/>
            <Image ID="G5" Texture="WarTrackerGlow.dds" Anchor="L,T" Offset="128,0" Size="96,96"/>
          </ShowOnMouseOver>

          <!-- icons overlap by half (32px step on 64px icons); later icons draw on top -->
          <Image ID="S1" Anchor="L,T" Offset="19,19"  Size="64,64" Color="0,0,0,90" />
          <Image ID="E1" Anchor="L,T" Offset="16,16"  Size="64,64"/>

          <Image ID="S2" Anchor="L,T" Offset="51,19"   Size="64,64" Color="0,0,0,90" />
          <Image ID="E2" Anchor="L,T" Offset="48,16"  Size="64,64"/>

          <Image ID="S3" Anchor="L,T" Offset="83,19"  Size="64,64" Color="0,0,0,90" />
          <Image ID="E3" Anchor="L,T" Offset="80,16"  Size="64,64"/>

          <Image ID="S4" Anchor="L,T" Offset="115,19"  Size="64,64" Color="0,0,0,90" />
          <Image ID="E4" Anchor="L,T" Offset="112,16" Size="64,64"/>

          <Image ID="S5" Anchor="L,T" Offset="147,19"  Size="64,64" Color="0,0,0,90" />
          <Image ID="E5" Anchor="L,T" Offset="144,16" Size="64,64"/>

          <!-- one shared crossed-swords text icon, placed by Lua on the last icon's lower-right corner -->
          <Label ID="WarIcon" Anchor="L,T" Offset="56,54" Font="TwCenMT24"/>

          <Label ID="MoreLabel" Anchor="L,T" Offset="212,36" Font="TwCenMT20" Color="235,205,120,255"/>
        </Button>
      </AlphaAnim>
    </Container>
  </Instance>

